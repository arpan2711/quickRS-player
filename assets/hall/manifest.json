{
 "scale": 6,
 "scale_note": "every sprite/map here is 6x of app size (sprite_px_per_app_px per entry; glass_key stays 3x)",
 "room": {
  "probe": {
   "file": "room_probe.jpg",
   "px": 1024,
   "bytes": "clamp(2.5 * linear_radiance), 8-bit; upload as an UNORM (non-sRGB) texture, or as egui ColorImage bytes as-is: the bytes are what gets added",
   "E_T": 2.5,
   "filter": "linear, clamp; mipmaps recommended (the arris minifies it ~10x)",
   "jpeg": "quality 96, 4:4:4 (no chroma subsampling)"
  },
  "probe_blur": {
   "file": "room_probe_blur.jpg",
   "px": 256,
   "bytes": "same encoding, the room blurred ~6 deg",
   "use": "GPU: the thumb (satin dish); CPU: the per-vertex local radiance L for every surface",
   "jpeg": "quality 95, 4:4:4"
  },
  "cpu_copy": "decode room_probe_blur.jpg once (256x256x3 u8); L_rgb(uv) = bilinear(bytes)/255/2.5",
  "srgb_mix_texture": "for the mix surfaces derive once at load: t = srgb_encode(min(1, 1.7 * bytes/255/2.5)) from room_probe.jpg (and from room_probe_blur.jpg for the thumb); upload as bytes",
  "pitch_deg": 36.0,
  "pitch_note": "already baked into the probe (the reflection centre looks 36 deg up into the hall); the app needs no rotation"
 },
 "geometry": {
  "frame": "screen frame: x right, y up, z toward the viewer; app px; sprite/app coords have y DOWN",
  "eye": "E = (W/2, H/2, D) with D = window width in app px (1440 for the 1440 x 900 window: 60 cm from a 60 cm screen); use the window's current size",
  "view": "v = normalize(Px - W/2, H/2 - Py, -D)",
  "reflect": "R = v - 2 (v.n) n",
  "sphere_map": "m = 2 sqrt(2 (1 + Rz)); u = 0.5 + Rx/m; v = 0.5 - Ry/m"
 },
 "blend": {
  "additive": {
   "surfaces": [
    "glass_key",
    "gem",
    "resin"
   ],
   "vertex": "Color32 grey c (r=g=b per channel), alpha 0 (egui premultiplied: additive)",
   "c": "c_ch = clamp(G * m * S_ch / E_T, 0, 1),  S_ch = (srgb(lin(base_ch) + x_ch) - base_ch) / x_ch,  x_ch = max(G * m * L_ch, 1e-5); base = the sprite colour under the vertex (sRGB 0..1, over the panel), L = CPU blurred probe at the vertex uv",
   "srgb_lin": "IEC sRGB (lin(c) = c<=0.04045 ? c/12.92 : ((c+0.055)/1.055)^2.4)"
  },
  "mix": {
   "surfaces": [
    "go_stone",
    "thumb"
   ],
   "vertex": "premultiplied (a, a, a, a)",
   "a": "a = min(0.5, 1.85 * m)",
   "texture": "the srgb_mix_texture (thumb: from the blurred probe)",
   "result": "out = fb (1 - a) + a * t"
  },
  "order": "base sprite, room mesh, gem-light deltas (reflect pack), icon/label"
 },
